# Scalekit credentials — get these at app.scalekit.com → Settings → API Credentials
SCALEKIT_ENV_URL=https://your-env.scalekit.dev
SCALEKIT_CLIENT_ID=skc_...
SCALEKIT_CLIENT_SECRET=your-secret

# User identifier — replace with the real user ID from your application
SCALEKIT_USER_IDENTIFIER=user_123

# MCP config name — must match the config created in Scalekit Dashboard
SCALEKIT_MCP_CONFIG_NAME=gmail-user-tools

# LLM — any OpenAI-compatible endpoint works (OpenAI, LiteLLM, etc.)
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://your-litellm-proxy.example.com/v1
# LLM_MODEL=gpt-4o